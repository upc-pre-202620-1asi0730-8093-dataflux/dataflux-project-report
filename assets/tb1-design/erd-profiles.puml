@startuml
title RentBuild | Proposed AV2 MySQL — Profiles
skinparam shadowing false
skinparam dpi 160
skinparam defaultFontName Arial
skinparam linetype ortho
skinparam packageStyle rectangle
entity "users [external owner]" as users {
  * id : BIGINT <<PK>>
}
entity "company_profiles" as company_profiles {
  * id : BIGINT <<PK>>
  user_id : BIGINT <<FK, UK>>
  first_name : VARCHAR(160)
  last_name : VARCHAR(160)
  contact_email : VARCHAR(255)
  phone_number : VARCHAR(32)
  company_name : VARCHAR(160)
  street : VARCHAR(255)
  district : VARCHAR(120)
  city : VARCHAR(120)
  country : VARCHAR(120)
  latitude : DECIMAL(10,7)
  longitude : DECIMAL(10,7)
}
users ||--o| company_profiles : owns zero or one profile
footer PROPOSED MYSQL SCHEMA — NO TABLE, FOREIGN KEY OR TRANSACTION IS CLAIMED IMPLEMENTED IN TB1
@enduml
