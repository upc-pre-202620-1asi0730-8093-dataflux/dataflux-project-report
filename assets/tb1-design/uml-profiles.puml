@startuml
title RentBuild | TB1 JavaScript — Profiles
skinparam shadowing false
skinparam dpi 160
skinparam defaultFontName Arial
skinparam linetype ortho
skinparam packageStyle rectangle
hide empty methods
skinparam classAttributeIconSize 0
class "CompanyProfile" as CompanyProfile {
  - Number id
  - Number userId
  - String firstName
  - String lastName
  - String contactEmail
  - String phoneNumber
  - String companyName
  - Address address
  --
  + constructor(props)
  + userId() Number
  + address() Address
}
class "Address" as Address <<ValueObject>> {
  - String street
  - String district
  - String city
  - String country
  - Number latitude
  - Number longitude
  --
  + constructor(props)
  + street() String
  + latitude() Number
}
class "ProfilesStore" as ProfilesStore {
  - ProfilesApi profilesApi
  - Ref profileState
  - Number version
  --
  + loadProfileByUserId(userId)
  + updateProfile(updatedProfile)
  + clearProfile()
}
class "ProfilesApi" as ProfilesApi {
  - ProfilesApiEndpoint profilesEndpoint
  --
  + getProfileByUserId(userId)
  + updateProfile(profile)
  + createProfile(profile)
}
CompanyProfile "1" *-- "1" Address : address
ProfilesStore "1" --> "1" ProfilesApi : profile API
ProfilesStore "1" --> "0..1" CompanyProfile : current profile state
footer TB1 JAVASCRIPT — DEVELOP 7e862dd + PR17 c4c3452 (PENDING REVIEW); NO C# BACKEND CLAIM
@enduml
