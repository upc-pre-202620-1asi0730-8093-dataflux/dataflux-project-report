@startuml
title RentBuild | TB1 JavaScript — Subscriptions
skinparam shadowing false
skinparam dpi 160
skinparam defaultFontName Arial
skinparam linetype ortho
skinparam packageStyle rectangle
hide empty methods
skinparam classAttributeIconSize 0
class "SubscriptionPlan" as SubscriptionPlan {
  - Number id
  - String name
  - String description
  - Money price
  - String billingCycle
  - String status
  --
  + constructor(props)
  + price() Money
  + status() String
}
class "UserSubscription" as UserSubscription {
  - Number id
  - Number userId
  - Number planId
  - DateRange period
  - String status
  - Boolean autoRenew
  --
  + constructor(props)
  + isActive(referenceDate) Boolean
  + period() DateRange
}
class "Subscriptions Money" as Money <<ValueObject>> {
  - Number amount
  - String currency
  --
  + constructor(props)
  + amount() Number
  + currency() String
}
class "Subscriptions DateRange" as DateRange <<ValueObject>> {
  - Date startDate
  - Date endDate
  --
  + constructor(props)
  + overlaps(other) Boolean
  + contains(date) Boolean
}
class "SubscriptionsStore" as SubscriptionsStore {
  - SubscriptionsApi subscriptionsApi
  - Ref plansState
  - Ref currentSubscriptionState
  - Number planRequestVersion
  --
  + loadPlans()
  + loadCurrentSubscription(userId)
  + subscribeToPlan(userId, planId)
  + changePlan(planId)
  + clear()
}
enum "SubscriptionStatus" as SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
  --
}
UserSubscription "0..*" --> "1" SubscriptionPlan : planId reference
SubscriptionPlan "1" *-- "1" Money : price
UserSubscription "1" *-- "1" DateRange : period
SubscriptionsStore "1" --> "0..1" UserSubscription : current subscription
UserSubscription ..> SubscriptionStatus : validates state values
footer TB1 JAVASCRIPT — DEVELOP 7e862dd + PR17 c4c3452 (PENDING REVIEW); NO C# BACKEND CLAIM
@enduml
