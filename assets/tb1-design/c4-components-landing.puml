@startuml
title RentBuild | C4 Components — Landing Container
skinparam shadowing false
skinparam dpi 160
skinparam defaultFontName Arial
skinparam packageStyle rectangle
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
Container(web, "Web Application", "Vue 3 / JavaScript", "Receives configured registration and sign-in navigation.")
Container_Boundary(landing_scope, "Landing Page [Container: HTML5 / CSS3 / JavaScript]") {
  Component(sections, "Public content and navigation", "HTML5 / CSS3 / JavaScript", "Segment value proposition, features, pricing examples and anchor navigation.")
  Component(cta, "Application link adapter", "JavaScript", "VITE_FRONTEND_URL; sign-in links and validated segment query for registration.")
  Component(locale, "Language resources and resolver", "JavaScript / JSON", "en-US / es-419 and legacy aliases; language preference in localStorage.")
  Component(docs, "Terms, privacy and accessible footer", "HTML5 / CSS3 / JavaScript", "Academic demo scope and keyboard-accessible document navigation.")
}
Rel(sections, cta, "Offers segment-specific navigation")
Rel(sections, locale, "Resolves translated public content")
Rel(locale, docs, "Resolves translated documents")
Rel(cta, web, "Navigates visitor [HTTPS]")
footer TB1 LANDING COMPONENTS; THE APPLICATION IS OUTSIDE THIS CONTAINER
@enduml
