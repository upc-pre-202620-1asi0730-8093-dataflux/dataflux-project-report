@startuml
' Native PlantUML source converted from eventstorming-support.json
skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam defaultFontSize 15
skinparam ArrowFontSize 13
skinparam dpi 144
title RentBuild | Design-Level — Supporting Contexts
skinparam rectangle {
  BorderColor #475569
  RoundCorner 8
}
left to right direction
rectangle "**IAM | Command**\nRegister Account / Sign In / Sign Out" as c0 #BFDBFE
rectangle "**Aggregate**\nUser / Session\nQuery: Own identity and permissions" as a0 #FDE68A
rectangle "**Domain event**\nAccountRegistered / SessionStarted /\nSessionEnded" as e0 #FDBA74
rectangle "**Profiles | Command**\nUpdate Company Profile" as c1 #BFDBFE
rectangle "**Aggregate**\nCompanyProfile / ProviderProfile\nQuery: Own profile / public provider" as a1 #FDE68A
rectangle "**Domain event**\nCompanyProfileUpdated" as e1 #FDBA74
rectangle "**Subscriptions | Command**\nSelect / Change Plan" as c2 #BFDBFE
rectangle "**Aggregate**\nSubscriptionPlan / UserSubscription\nQuery: Plans + current valid period" as a2 #FDE68A
rectangle "**Domain event**\nDemoPlanSelected / DemoPlanChanged" as e2 #FDBA74
c0 --> a0 : Validates
a0 --> e0 : Emits if accepted
c1 --> a1 : Validates
a1 --> e1 : Emits if accepted
c2 --> a2 : Validates
a2 --> e2 : Emits if accepted
c0 -[hidden]down-> c1
c1 -[hidden]down-> c2
legend bottom
|= Color |= Meaning |
| <#BFDBFE> Blue | Command |
| <#FDE68A> Yellow | Aggregate |
| <#FDBA74> Orange | Domain event |
endlegend
caption PROPOSED MODEL: COMMAND (BLUE), AGGREGATE (YELLOW), EVENT (ORANGE); NOT IMPLEMENTED\nBUS
@enduml
