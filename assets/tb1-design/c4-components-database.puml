@startuml
title RentBuild | Proposed MySQL — Logical Schema Structure
skinparam shadowing false
skinparam dpi 160
skinparam defaultFontName Arial
skinparam packageStyle rectangle
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
Container_Boundary(db_scope, "Relational Database [Container: MySQL] — logical decomposition, not executable application components") {
  Component(iam, "IAM / Profiles ownership", "MySQL", "users; company_profiles. Identity/profile references by user_id.")
  Component(inventory, "Inventory ownership", "MySQL", "equipment_categories, equipments, availability_blocks. Own equipment data and period commitments.")
  Component(rentals, "Rentals ownership", "MySQL", "rental_requests, rentals, deliveries, equipment_returns. Confirmed and active rental lifecycle.")
  Component(support, "Maintenance / Subscriptions ownership", "MySQL", "incidents, maintenances; subscription_plans, user_subscriptions. Separate owners.")
}
Rel(iam, inventory, "Proposed AV2: Proposed user_id references")
Rel(inventory, rentals, "Proposed AV2: Proposed equipment_id references")
Rel(inventory, support, "Proposed AV2: Proposed equipment_id references")
Rel(iam, support, "Proposed AV2: Proposed subscription user_id references")
footer DATABASE TABLE GROUPS ARE NOT C4 CODE COMPONENTS; SEE THE SIX ERD VIEWS FOR KEYS AND CARDINALITIES
@enduml
