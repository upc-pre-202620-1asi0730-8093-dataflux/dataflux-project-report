@startuml
title RentBuild | TB1 JavaScript — Explicit Value Objects
skinparam shadowing false
skinparam dpi 160
skinparam defaultFontName Arial
skinparam linetype ortho
skinparam packageStyle rectangle
hide empty methods
skinparam classAttributeIconSize 0
class "Shared Money" as Money <<ValueObject>> {
  - Number amount
  - String currency
  --
  + constructor(props)
  + amount() Number
  + currency() String
}
class "Shared DateRange" as DateRange <<ValueObject>> {
  - Date startDate
  - Date endDate
  --
  + constructor(props)
  + overlaps(other) Boolean
  + contains(date) Boolean
}
class "Inventory RentalRate" as RentalRate <<ValueObject>> {
  - Money daily
  - Money weekly
  --
  + constructor(props)
  + dailyMoney() Money
  + weeklyMoney() Money
  + currency() String
}
class "Profiles Address" as Address <<ValueObject>> {
  - String street
  - String district
  - String city
  - String country
  - Number latitude
  - Number longitude
  --
  + constructor(props)
  + street() String
  + latitude() Number
}
class "Subscriptions Money" as SubscriptionMoney <<ValueObject>> {
  - Number amount
  - String currency
  --
  + constructor(props)
  + amount() Number
  + currency() String
}
class "Subscriptions DateRange" as SubscriptionDateRange <<ValueObject>> {
  - Date startDate
  - Date endDate
  --
  + constructor(props)
  + overlaps(other) Boolean
  + contains(date) Boolean
}
RentalRate "1" *-- "2" Money : daily and weekly amounts
footer TB1 JAVASCRIPT — DEVELOP 7e862dd + PR17 c4c3452 (PENDING REVIEW); NO C# BACKEND CLAIM
@enduml
