@startuml
title RentBuild | TB1 JavaScript — Rentals
skinparam shadowing false
skinparam dpi 160
skinparam defaultFontName Arial
skinparam linetype ortho
skinparam packageStyle rectangle
hide empty methods
skinparam classAttributeIconSize 0
class "RentalRequest" as RentalRequest {
  - Number id
  - Number equipmentId
  - Number constructionUserId
  - Number rentalCompanyUserId
  - DateRange period
  - String status
  - Date createdAt
  --
  + constructor(props)
  + approve()
  + reject()
  - ensurePending()
}
class "Rental" as Rental {
  - Number id
  - Number equipmentId
  - Number constructionUserId
  - Number rentalCompanyUserId
  - DateRange period
  - String status
  - Number rentalRequestId
  --
  + constructor(props)
  + registerDelivery()
  + registerReturn()
  + isActive() Boolean
}
class "Delivery" as Delivery {
  - Number id
  - Number rentalId
  - Date deliveredAt
  - String notes
  --
  + constructor(props)
  + rentalId() Number
}
class "EquipmentReturn" as EquipmentReturn {
  - Number id
  - Number rentalId
  - Date returnedAt
  - String notes
  - Boolean maintenanceRequired
  --
  + constructor(props)
  + requiresMaintenance() Boolean
}
class "Shared DateRange" as DateRange <<ValueObject>> {
  - Date startDate
  - Date endDate
  --
  + constructor(props)
  + overlaps(other) Boolean
  + contains(date) Boolean
}
class "RentalsStore" as RentalsStore {
  - RentalsApi rentalsApi
  - Ref rentalRequestsState
  - Ref rentalsState
  --
  + approveRentalRequest(requestId)
  + rejectRentalRequest(requestId)
  + registerDelivery(id, date, notes)
  + registerReturn(id, date, notes, flag)
}
RentalRequest "1" *-- "1" DateRange : requested period
Rental "1" *-- "1" DateRange : agreed period
Delivery "0..1" --> "1" Rental : references rentalId
EquipmentReturn "0..1" --> "1" Rental : references rentalId
RentalsStore "1" --> "0..*" RentalRequest : request state
RentalsStore "1" --> "0..*" Rental : rental state
footer TB1 JAVASCRIPT — DEVELOP 7e862dd + PR17 c4c3452 (PENDING REVIEW); NO C# BACKEND CLAIM
@enduml
