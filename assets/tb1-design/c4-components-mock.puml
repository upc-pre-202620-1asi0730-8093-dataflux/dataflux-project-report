@startuml
title RentBuild | C4 Components — TB1 Demo API
skinparam shadowing false
skinparam dpi 160
skinparam defaultFontName Arial
skinparam packageStyle rectangle
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
Container(web, "Web Application", "Vue 3 / JavaScript", "HttpClient consumes demo responses.")
Container_Boundary(mock_scope, "Demo API [Container: Node.js / json-server] — TB1 only") {
  Component(host, "server/index.cjs — HTTP composition", "Node.js / JavaScript", "PORT configuration and local listener; mounts demo authentication and JSON resource routes.")
  Component(auth, "Demo authentication handlers", "Node.js / JavaScript", "Illustrative sign-up/sign-in, temporary token handling and demo credential matching.")
  Component(router, "Resource router", "json-server 0.17 / JavaScript", "CRUD routes and rewrites from server/routes.json.")
  Component(data, "Demo data adapter", "JSON file / json-server", "server/db.json fixtures; mutable and resettable. No relational guarantees.")
}
Rel(web, host, "Calls demo routes [HTTP/HTTPS + JSON]")
Rel(host, auth, "Handles authentication demo requests")
Rel(host, router, "Dispatches resource requests")
Rel(router, data, "Reads/writes mock records [local JSON file]")
footer ACADEMIC MOCK: NO ASP.NET CORE, MYSQL TRANSACTIONS OR PRODUCTION AUTHORIZATION CLAIM
@enduml
