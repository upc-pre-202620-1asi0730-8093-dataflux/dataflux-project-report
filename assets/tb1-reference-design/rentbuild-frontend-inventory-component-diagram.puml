@startuml
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam dpi 130
!include <C4/C4_Component>

LAYOUT_WITH_LEGEND()

title RentBuild - Inventory Frontend Components Diagram

Container_Boundary(inventory_frontend, "Inventory Frontend Bounded Context\n[Vue 3 Bounded Context Module]\n[container]") {
    Component(presentation_layer, "Presentation Layer", "Pages / Components / Routes", "Renders machinery catalog, equipment details, availability, rates, and inventory management views.")
    Component(application_layer, "Application Layer", "Facades / Services", "Coordinates equipment queries, inventory operations, availability state, and frontend workflows.")
    Component(infrastructure_layer, "Infrastructure Layer", "API Clients / Mappers", "Consumes Inventory backend endpoints and maps equipment resources into frontend models.")
    Component(domain_layer, "Domain Layer", "Models / Rules", "Defines equipment, category, rate, status, and availability models and frontend business rules.")
}

Component_Ext(rentals, "Rentals", "Frontend Context", "Uses machinery information and availability when creating and managing rental requests.")
Component_Ext(maintenance, "Maintenance", "Frontend Context", "Coordinates equipment maintenance status and availability changes.")
Component_Ext(shared_frontend, "Shared Frontend", "Shared UI / Session", "Provides reusable UI primitives, session utilities, guards, and shared frontend services.")

Container_Ext(backend_api, "RentBuild Backend API", "External Container", "REST API consumed by the Inventory frontend context.")

' Internal Container Relationships
Rel(presentation_layer, application_layer, "Dispatches UI actions")
Rel(application_layer, infrastructure_layer, "Requests equipment data")
Rel(application_layer, domain_layer, "Applies inventory and availability rules")

' External Component Relationships
Rel(presentation_layer, shared_frontend, "Uses layout / UI primitives")
Rel(application_layer, rentals, "Provides machinery availability")
Rel(application_layer, maintenance, "Coordinates equipment status")
Rel(application_layer, shared_frontend, "Uses shared services")

' External Container Relationships
Rel(infrastructure_layer, backend_api, "Consumes Inventory REST endpoints", "JSON / HTTPS")
footer Proposed product design — C# / ASP.NET Core / EF Core / MySQL; implementation is not claimed
@enduml
