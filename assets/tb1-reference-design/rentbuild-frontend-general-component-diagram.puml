@startuml
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam dpi 130
!include <C4/C4_Component>

LAYOUT_WITH_LEGEND()

title RentBuild - Frontend General Components Diagram

Person(rental_operator, "Rental Operator", "Uses the RentBuild SPA to manage machinery and rental operations.")
Person(construction_manager, "Construction Manager", "Uses the RentBuild SPA to search machinery and manage rental requests.")

Container_Boundary(frontend_boundary, "RentBuild Frontend Bounded Context Map\n[Vue SPA / Frontend Container]") {

    Component(app_layout, "App Layout", "Vue 3, Vue Router, Pinia, PrimeVue, JavaScript", "Provides the application shell, toolbar, navigation, contextual layout, and router outlet.")
    Component(app_router, "App Router", "Vue Router", "Routes users to the frontend bounded contexts.")
    Component(shared_ctx, "Shared Context", "Shared Frontend Component", "Provides reusable UI components, guards, session support, utilities, configuration, and shared services.")

    Component(subscriptions_ctx, "Subscriptions Context", "Bounded Context Component", "Provides plan catalog, current subscription, plan changes, and subscription management.")
    Component(profiles_ctx, "Profiles Context", "Bounded Context Component", "Provides user, company, and supplier profile management.")
    Component(iam_ctx, "IAM Context", "Bounded Context Component", "Provides login, registration, password recovery, authentication, and session management.")
    Component(rentals_ctx, "Rentals Context", "Bounded Context Component", "Provides rental requests, reservations, deliveries, active rentals, and returns.")
    Component(maintenance_ctx, "Maintenance Context", "Bounded Context Component", "Provides maintenance schedules, inspections, incidents, and machinery maintenance history.")
    Component(inventory_ctx, "Inventory Context", "Bounded Context Component", "Provides machinery catalog, equipment details, rates, availability, and inventory management.")

    Component(api_infra, "API and Local Data Infrastructure", "JavaScript / Axios / RxJS", "Provides typed REST services, HTTP communication, local session persistence, and frontend data access.")
}

Container_Ext(backend_api, "RentBuild Backend API", "C# / ASP.NET Core", "REST API consumed by the frontend.")

' Person Relationships
Rel(rental_operator, app_layout, "Uses")
Rel(construction_manager, app_layout, "Uses")

' Layout and Router
Rel(app_layout, app_router, "Displays routed views")

' App Router to Contexts
Rel(app_router, subscriptions_ctx, "Routes")
Rel(app_router, profiles_ctx, "Routes")
Rel(app_router, rentals_ctx, "Routes")
Rel(app_router, maintenance_ctx, "Routes")

' Shared Context Relations
Rel(shared_ctx, subscriptions_ctx, "Provides shared UI and utilities")
Rel(shared_ctx, profiles_ctx, "Provides shared UI and utilities")
Rel(shared_ctx, iam_ctx, "Provides shared session UI and services")
Rel(shared_ctx, rentals_ctx, "Provides shared UI and utilities")
Rel(shared_ctx, maintenance_ctx, "Provides shared UI and utilities")
Rel(shared_ctx, inventory_ctx, "Provides shared UI and utilities")

' Inter-Context Relations
Rel(subscriptions_ctx, iam_ctx, "Uses authenticated account context")
Rel(profiles_ctx, iam_ctx, "Uses authenticated account context")
Rel(rentals_ctx, inventory_ctx, "Uses machinery availability")
Rel(maintenance_ctx, inventory_ctx, "Updates machinery availability")

' Contexts to API Infrastructure
Rel(iam_ctx, api_infra, "Uses REST services")
Rel(subscriptions_ctx, api_infra, "Uses REST services")
Rel(profiles_ctx, api_infra, "Uses REST services")
Rel(rentals_ctx, api_infra, "Uses REST services")
Rel(maintenance_ctx, api_infra, "Uses REST services")
Rel(inventory_ctx, api_infra, "Uses REST services")

' API Infrastructure to Backend API
Rel(api_infra, backend_api, "Consumes", "JSON / HTTPS")
footer Proposed product design — C# / ASP.NET Core / EF Core / MySQL; implementation is not claimed
@enduml
