@startuml
title RentBuild — Reference relational design adapted to MySQL
skinparam shadowing false
skinparam defaultFontName Arial
skinparam dpi 130
hide circle
skinparam classAttributeIconSize 0
package "IAM" {
    entity "users" as users {
        * id : BIGINT <<PK>>
        --
        * email : VARCHAR(120) <<UNIQUE>>
        * password_hash : VARCHAR(255)
        * role : VARCHAR(30)
        * status : VARCHAR(20)
        * created_at : TIMESTAMP
    }
}
package "Profiles" {
    entity "company_profiles" as company_profiles {
        * id : BIGINT <<PK>>
        --
        * user_id : BIGINT <<FK, UNIQUE>>
        * company_name : VARCHAR(150)
        * ruc : VARCHAR(11) <<UNIQUE>>
        * company_type : VARCHAR(30)
        * contact_phone : VARCHAR(20)
        * contact_email : VARCHAR(120)
        street : VARCHAR(150)
        district : VARCHAR(80)
        city : VARCHAR(80)
        latitude : DECIMAL(9,6)
        longitude : DECIMAL(9,6)
    }
    entity "provider_profiles" as provider_profiles {
        * id : BIGINT <<PK>>
        --
        * company_profile_id : BIGINT <<FK, UNIQUE>>
        description : TEXT
        completed_rentals : INT
        fulfillment_rate : DECIMAL(5,2)
        is_public : BOOLEAN
    }
}
package "Subscriptions" {
    entity "subscription_plans" as subscription_plans {
        * id : BIGINT <<PK>>
        --
        * name : VARCHAR(80) <<UNIQUE>>
        description : TEXT
        * price : DECIMAL(10,2)
        * billing_cycle : VARCHAR(20)
        * status : VARCHAR(20)
    }
    entity "user_subscriptions" as user_subscriptions {
        * id : BIGINT <<PK>>
        --
        * user_id : BIGINT <<FK>>
        * plan_id : BIGINT <<FK>>
        * start_date : DATE
        * end_date : DATE
        * status : VARCHAR(20)
        * auto_renew : BOOLEAN
    }
}
package "Inventory" {
    entity "equipment_categories" as equipment_categories {
        * id : BIGINT <<PK>>
        --
        * name : VARCHAR(80) <<UNIQUE>>
        description : VARCHAR(255)
    }
    entity "equipments" as equipments {
        * id : BIGINT <<PK>>
        --
        * provider_id : BIGINT <<FK>>
        * category_id : BIGINT <<FK>>
        * name : VARCHAR(120)
        brand : VARCHAR(80)
        model : VARCHAR(80)
        * serial_number : VARCHAR(80) <<UNIQUE>>
        location : VARCHAR(150)
        * daily_rate : DECIMAL(10,2)
        weekly_rate : DECIMAL(10,2)
        currency : CHAR(3)
        * status : VARCHAR(20)
        * created_at : TIMESTAMP
    }
    entity "availability_blocks" as availability_blocks {
        * id : BIGINT <<PK>>
        --
        * equipment_id : BIGINT <<FK>>
        * start_date : DATE
        * end_date : DATE
        reason : VARCHAR(120)
    }
}
package "Rentals" {
    entity "rental_requests" as rental_requests {
        * id : BIGINT <<PK>>
        --
        * equipment_id : BIGINT <<FK>>
        * construction_company_id : BIGINT <<FK>>
        * provider_id : BIGINT <<FK>>
        * start_date : DATE
        * end_date : DATE
        * status : VARCHAR(20)
        * requested_at : TIMESTAMP
        notes : TEXT
        rejection_reason : VARCHAR(255)
    }
    entity "rental_contracts" as rental_contracts {
        * id : BIGINT <<PK>>
        --
        * request_id : BIGINT <<FK, UNIQUE>>
        * equipment_id : BIGINT <<FK>>
        * construction_company_id : BIGINT <<FK>>
        * provider_id : BIGINT <<FK>>
        * start_date : DATE
        * end_date : DATE
        * total_amount : DECIMAL(12,2)
        terms : TEXT
        * status : VARCHAR(20)
        * created_at : TIMESTAMP
    }
    entity "deliveries" as deliveries {
        * id : BIGINT <<PK>>
        --
        * contract_id : BIGINT <<FK, UNIQUE>>
        * delivered_at : TIMESTAMP
        * delivery_location : VARCHAR(150)
        received_by : VARCHAR(120)
        observations : TEXT
    }
    entity "equipment_returns" as equipment_returns {
        * id : BIGINT <<PK>>
        --
        * contract_id : BIGINT <<FK, UNIQUE>>
        * returned_at : TIMESTAMP
        condition_on_return : VARCHAR(255)
        has_damage : BOOLEAN
        inspection_notes : TEXT
    }
}
package "Maintenance" {
    entity "incidents" as incidents {
        * id : BIGINT <<PK>>
        --
        * equipment_id : BIGINT <<FK>>
        contract_id : BIGINT <<FK>>
        * reported_at : TIMESTAMP
        * severity : VARCHAR(20)
        * status : VARCHAR(20)
        * description : TEXT
    }
    entity "maintenance_records" as maintenance_records {
        * id : BIGINT <<PK>>
        --
        * equipment_id : BIGINT <<FK>>
        incident_id : BIGINT <<FK, UNIQUE>>
        * type : VARCHAR(20)
        * status : VARCHAR(20)
        scheduled_date : DATE
        completed_date : DATE
        description : TEXT
        cost : DECIMAL(10,2)
    }
}
users ||--o| company_profiles : user_id
company_profiles ||--o| provider_profiles : company_profile_id
users ||--o{ user_subscriptions : user_id
subscription_plans ||--o{ user_subscriptions : plan_id
provider_profiles ||--o{ equipments : provider_id
equipment_categories ||--o{ equipments : category_id
equipments ||--o{ availability_blocks : equipment_id
equipments ||--o{ rental_requests : equipment_id
company_profiles ||--o{ rental_requests : construction_company_id
provider_profiles ||--o{ rental_requests : provider_id
rental_requests ||--o| rental_contracts : request_id
equipments ||--o{ rental_contracts : equipment_id
company_profiles ||--o{ rental_contracts : construction_company_id
provider_profiles ||--o{ rental_contracts : provider_id
rental_contracts ||--o| deliveries : contract_id
rental_contracts ||--o| equipment_returns : contract_id
equipments ||--o{ incidents : equipment_id
rental_contracts |o--o{ incidents : contract_id
equipments ||--o{ maintenance_records : equipment_id
incidents |o--o| maintenance_records : incident_id
footer Proposed AV2 schema — cardinalities reconciled with the existing class diagrams
@enduml
