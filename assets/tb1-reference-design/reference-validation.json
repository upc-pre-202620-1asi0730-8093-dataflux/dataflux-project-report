  "relationalAdjustments": [
    "Retain ProviderProfile and RentalContract instead of replacing them with TB1 DTOs",
    "provider_id references ProviderProfileId, matching the reference Inventory/Rentals UML",
    "request/contract/delivery/return cardinalities allow the existing pending lifecycle",
    "optional company/provider profile and optional incident/maintenance associations match the reference UML",
    "nullable unique maintenance incident_id preserves the reference zero-or-one association",
    "six per-context views share the same tables and FK graph as the global reference schema"
  ]
