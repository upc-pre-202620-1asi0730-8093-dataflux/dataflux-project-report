@startuml
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam dpi 130
!include <C4/C4_Component>

LAYOUT_WITH_LEGEND()

title RentBuild- Inventory Frontend Component Diagram (DDD Layers)

Container_Boundary(inventory_frontend, "Inventory Frontend Bounded Context\n[container]") {

    Boundary(presentation_boundary, "Presentation") {
        Component(equipment_list_comp, "EquipmentListComponent", "Vue Component", "Displays machinery and equipment available in the inventory")
        Component(equipment_detail_comp, "EquipmentDetailComponent", "Vue Component", "Displays detailed machinery information, rates, status and availability")
        Component(equipment_form_comp, "EquipmentFormComponent", "Vue Component", "Provides machinery registration and editing interaction")

        Component(equipment_search_comp, "EquipmentSearchComponent", "Vue Component", "Provides machinery search interaction")
        Component(equipment_filter_comp, "EquipmentFilterComponent", "Vue Component", "Provides category, status and availability filtering")
        Component(availability_badge_comp, "AvailabilityBadgeComponent", "Vue Component", "Displays equipment availability using a reusable visual indicator")
    }

    Boundary(application_boundary, "Application") {
        Component(inventory_app, "inventory/application", "JavaScript", "Coordinates equipment queries, inventory operations, availability state and frontend use cases")
    }

    Boundary(infrastructure_boundary, "Infrastructure") {
        Component(inventory_infra, "inventory/infrastructure", "HTTP, Resources, Mappers", "Consumes Inventory REST endpoints and maps backend resources into frontend inventory models")
    }

    Boundary(domain_boundary, "Domain") {
        Component(inventory_domain, "inventory/domain/model", "Entities / Value Objects", "Equipment, Category, Rate, Availability and EquipmentStatus models and business rules")
    }
}

Container_Ext(backend_api, "RentBuild Backend API", "C# / ASP.NET Core", "Exposes machinery, equipment and inventory-related RESTful services consumed by the Inventory frontend")

' UI Component Dependencies (Presentation internal)
Rel(equipment_list_comp, equipment_search_comp, "Uses")
Rel(equipment_list_comp, equipment_filter_comp, "Uses")
Rel(equipment_list_comp, availability_badge_comp, "Uses")
Rel(equipment_detail_comp, availability_badge_comp, "Uses")

' Presentation to Application Relations
Rel(equipment_list_comp, inventory_app, "Requests equipment list")
Rel(equipment_detail_comp, inventory_app, "Requests equipment details")
Rel(equipment_form_comp, inventory_app, "Creates or updates equipment")

' Application Relationships
Rel(inventory_app, inventory_infra, "Loads and updates inventory data through")
Rel(inventory_app, inventory_domain, "Holds and applies inventory state and rules")

' Infrastructure Relationships
Rel(inventory_infra, inventory_domain, "Maps resources into")
Rel(inventory_infra, backend_api, "Consumes Inventory REST endpoints", "HTTPS / JSON")
footer Proposed product design — C# / ASP.NET Core / EF Core / MySQL; implementation is not claimed
@enduml
