@startuml
title RentBuild — Inventory — Proposed MySQL design
skinparam shadowing false
skinparam defaultFontName Arial
skinparam dpi 130
hide circle
skinparam classAttributeIconSize 0
package "Inventory" {
    entity "equipment_categories" as equipment_categories {
        * id : BIGINT <<PK>>
        --
        * name : VARCHAR(80) <<UNIQUE>>
        description : VARCHAR(255)
    }
    entity "equipments" as equipments {
        * id : BIGINT <<PK>>
        --
        * provider_id : BIGINT <<FK>>
        * category_id : BIGINT <<FK>>
        * name : VARCHAR(120)
        brand : VARCHAR(80)
        model : VARCHAR(80)
        * serial_number : VARCHAR(80) <<UNIQUE>>
        location : VARCHAR(150)
        * daily_rate : DECIMAL(10,2)
        weekly_rate : DECIMAL(10,2)
        currency : CHAR(3)
        * status : VARCHAR(20)
        * created_at : TIMESTAMP
    }
    entity "availability_blocks" as availability_blocks {
        * id : BIGINT <<PK>>
        --
        * equipment_id : BIGINT <<FK>>
        * start_date : DATE
        * end_date : DATE
        reason : VARCHAR(120)
    }
}
entity "incidents [external owner]" as incidents #EEEEEE {
  * id : BIGINT <<PK>>
}
entity "maintenance_records [external owner]" as maintenance_records #EEEEEE {
  * id : BIGINT <<PK>>
}
entity "provider_profiles [external owner]" as provider_profiles #EEEEEE {
  * id : BIGINT <<PK>>
}
entity "rental_contracts [external owner]" as rental_contracts #EEEEEE {
  * id : BIGINT <<PK>>
}
entity "rental_requests [external owner]" as rental_requests #EEEEEE {
  * id : BIGINT <<PK>>
}
provider_profiles ||--o{ equipments : provider_id
equipment_categories ||--o{ equipments : category_id
equipments ||--o{ availability_blocks : equipment_id
equipments ||--o{ rental_requests : equipment_id
equipments ||--o{ rental_contracts : equipment_id
equipments ||--o{ incidents : equipment_id
equipments ||--o{ maintenance_records : equipment_id
footer Proposed AV2 schema; reference domain preserved; no deployed tables or migrations are claimed
@enduml
