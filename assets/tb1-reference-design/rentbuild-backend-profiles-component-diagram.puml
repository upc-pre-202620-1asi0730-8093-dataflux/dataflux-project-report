@startuml
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam dpi 130
!include <C4/C4_Component>

LAYOUT_WITH_LEGEND()

title RentBuild - Profiles Backend Component Diagram

Container(spa, "Single Page Application", "Vue", "Consumes profile-management capabilities provided by the RentBuild backend.")

Container_Boundary(profiles_context, "RentBuild RESTful API / ASP.NET Core — Profiles context detail") {
    Component(interfaces_layer, "Interfaces Layer", "REST Controllers / DTOs", "Exposes endpoints for user profiles, company profiles, supplier information, and profile updates.")
    Component(application_layer, "Application Layer", "Application Services / Command and Query Services", "Coordinates profile registration, profile updates, company information, and profile-query use cases.")
    Component(domain_layer, "Domain Layer", "Aggregates / Entities / Value Objects / Domain Services", "Contains user profile, company profile, supplier information, and profile-related business rules.")
    Component(infrastructure_layer, "Infrastructure Layer", "EF Core / Repository Implementations", "Provides persistence implementations and technical adapters required by the Profiles bounded context.")
}

Component_Ext(iam_bc, "IAM Bounded Context", "Backend Context", "Provides authenticated account identity and access information.")
ContainerDb(database, "RentBuild Database", "MySQL", "Stores user, company, supplier, and profile-related information.")

' SPA Relationships
Rel(spa, interfaces_layer, "Consumes Profiles services", "JSON / HTTPS")

' Internal Layer Relationships
Rel(interfaces_layer, application_layer, "Delegates requests")
Rel(application_layer, domain_layer, "Executes profile domain operations")
Rel(application_layer, infrastructure_layer, "Uses persistence capabilities")

' External Bounded Context & Database Relationships
Rel(application_layer, iam_bc, "Uses authenticated account identity")
Rel(infrastructure_layer, database, "Reads and writes Profiles data", "EF Core / SQL")
footer Proposed product design — C# / ASP.NET Core / EF Core / MySQL; implementation is not claimed
@enduml
