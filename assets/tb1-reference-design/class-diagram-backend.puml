@startuml
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam dpi 130
skinparam classAttributeIconSize 0

title RentBuild - System Level Backend Class Diagram (Domain Layer)

package "Rentals Bounded Context [Backend]" {
    class RentalContract <<Aggregate Root>> {
        - id: long
        - requestId: long
        - equipmentId: long
        - totalAmount: decimal
        - status: ContractStatus
    }

    class RentalRequest <<Aggregate Root>> {
        - id: long
        - equipmentId: long
        - constructionCompanyId: long
        - status: RequestStatus
    }
}

package "Maintenance Bounded Context [Backend]" {
    class MaintenanceRecord <<Aggregate Root>> {
        - id: long
        - equipmentId: long
        - incidentId: long
        - type: MaintenanceType
        - cost: decimal
    }

    class Incident <<Aggregate Root>> {
        - id: long
        - equipmentId: long
        - contractId: long
        - severity: string
        - status: IncidentStatus
    }
}

package "Inventory Bounded Context [Backend]" {
    class Equipment <<Aggregate Root>> {
        - id: long
        - providerId: long
        - categoryId: long
        - name: string
        - serialNumber: string
        - dailyRate: decimal
        - status: EquipmentStatus
    }
}

package "Profiles Bounded Context [Backend]" {
    class CompanyProfile <<Aggregate Root>> {
        - id: long
        - userId: long
        - companyName: string
        - ruc: string
        - companyType: CompanyType
        - contactPhone: string
        - contactEmail: string
    }
}

package "IAM Bounded Context [Backend]" {
    class User <<Aggregate Root>> {
        - id: long
        - email: string
        - passwordHash: string
        - role: UserRole
        - status: UserStatus
        + authenticate(): bool
    }
}

package "Subscriptions Bounded Context [Backend]" {
    class UserSubscription <<Aggregate Root>> {
        - id: long
        - userId: long
        - planId: long
        - status: SubscriptionStatus
        - autoRenew: bool
    }

    class SubscriptionPlan <<Aggregate Root>> {
        - id: long
        - name: string
        - price: decimal
        - billingCycle: string
    }
}

' Relaciones internas del mismo Bounded Context
RentalContract "1" --> "1" RentalRequest : references requestId
MaintenanceRecord "1" --> "0..1" Incident : references incidentId
UserSubscription "1" --> "1" SubscriptionPlan : references planId

' Relaciones entre Bounded Contexts
RentalRequest "1" --> "1" Equipment : references equipmentId
Incident "1" --> "1" Equipment : references equipmentId
Equipment "1" --> "1" CompanyProfile : references providerId
CompanyProfile "1" --> "1" User : references userId
UserSubscription "1" --> "1" User : references userId
footer Proposed product design — C# / ASP.NET Core / EF Core / MySQL; implementation is not claimed
@enduml
