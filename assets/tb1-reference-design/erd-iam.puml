@startuml
title RentBuild — IAM — Proposed MySQL design
skinparam shadowing false
skinparam defaultFontName Arial
skinparam dpi 130
hide circle
skinparam classAttributeIconSize 0
package "IAM" {
    entity "users" as users {
        * id : BIGINT <<PK>>
        --
        * email : VARCHAR(120) <<UNIQUE>>
        * password_hash : VARCHAR(255)
        * role : VARCHAR(30)
        * status : VARCHAR(20)
        * created_at : TIMESTAMP
    }
}
entity "company_profiles [external owner]" as company_profiles #EEEEEE {
  * id : BIGINT <<PK>>
}
entity "user_subscriptions [external owner]" as user_subscriptions #EEEEEE {
  * id : BIGINT <<PK>>
}
users ||--o| company_profiles : user_id
users ||--o{ user_subscriptions : user_id
footer Proposed AV2 schema; reference domain preserved; no deployed tables or migrations are claimed
@enduml
