@startuml
title RentBuild — Subscriptions — Proposed MySQL design
skinparam shadowing false
skinparam defaultFontName Arial
skinparam dpi 130
hide circle
skinparam classAttributeIconSize 0
package "Subscriptions" {
    entity "subscription_plans" as subscription_plans {
        * id : BIGINT <<PK>>
        --
        * name : VARCHAR(80) <<UNIQUE>>
        description : TEXT
        * price : DECIMAL(10,2)
        * billing_cycle : VARCHAR(20)
        * status : VARCHAR(20)
    }
    entity "user_subscriptions" as user_subscriptions {
        * id : BIGINT <<PK>>
        --
        * user_id : BIGINT <<FK>>
        * plan_id : BIGINT <<FK>>
        * start_date : DATE
        * end_date : DATE
        * status : VARCHAR(20)
        * auto_renew : BOOLEAN
    }
}
entity "users [external owner]" as users #EEEEEE {
  * id : BIGINT <<PK>>
}
users ||--o{ user_subscriptions : user_id
subscription_plans ||--o{ user_subscriptions : plan_id
footer Proposed AV2 schema; reference domain preserved; no deployed tables or migrations are claimed
@enduml
