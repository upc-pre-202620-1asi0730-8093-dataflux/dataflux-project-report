@startuml
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam dpi 130
!include <C4/C4_Component>

LAYOUT_WITH_LEGEND()

title RentBuild - Rentals Frontend Component Diagram (DDD Layers)

Container_Boundary(rentals_frontend, "Rentals Frontend Bounded Context\n[container]") {

    Boundary(presentation_boundary, "Presentation") {
        Component(rental_requests_comp, "RentalRequestsComponent", "Vue Component", "Displays and manages rental requests")
        Component(rental_request_detail_comp, "RentalRequestDetailComponent", "Vue Component", "Displays detailed information for a selected rental request")
        Component(reservations_comp, "ReservationsComponent", "Vue Component", "Displays confirmed machinery reservations")
        Component(active_rentals_comp, "ActiveRentalsComponent", "Vue Component", "Displays currently active rental operations")
        Component(delivery_form_comp, "DeliveryFormComponent", "Vue Component", "Provides the interface for registering machinery delivery")
        Component(return_form_comp, "ReturnFormComponent", "Vue Component", "Provides the interface for registering machinery return")
    }

    Boundary(application_boundary, "Application") {
        Component(rentals_app, "rentals/application", "JavaScript", "Coordinates rental requests, reservations, deliveries, active rentals, returns and frontend rental state")
    }

    Boundary(infrastructure_boundary, "Infrastructure") {
        Component(rentals_infra, "rentals/infrastructure", "HTTP, Resources, Mappers", "Consumes Rentals REST endpoints and maps backend resources into frontend rental models")
    }

    Boundary(domain_boundary, "Domain") {
        Component(rentals_domain, "rentals/domain/model", "Entities / Value Objects", "RentalRequest, Reservation, RentalContract, Delivery and Return models and rental business rules")
    }
}

Container_Ext(backend_api, "RentBuild Backend API", "C# / ASP.NET Core", "Exposes rental, reservation, delivery and return-related RESTful services consumed by the Rentals frontend")

' Presentation Internal Navigation
Rel(rental_requests_comp, rental_request_detail_comp, "Navigates to")

' Presentation to Application Relations
Rel(rental_requests_comp, rentals_app, "Requests rental operations")
Rel(rental_request_detail_comp, rentals_app, "Requests rental details")
Rel(reservations_comp, rentals_app, "Requests reservation data")
Rel(active_rentals_comp, rentals_app, "Requests active rentals")
Rel(delivery_form_comp, rentals_app, "Registers delivery")
Rel(return_form_comp, rentals_app, "Registers return")

' Application Relationships
Rel(rentals_app, rentals_infra, "Loads and updates rental data through")
Rel(rentals_app, rentals_domain, "Holds and applies rental state and rules")

' Infrastructure Relationships
Rel(rentals_infra, rentals_domain, "Maps resources into")
Rel(rentals_infra, backend_api, "Consumes Rentals REST endpoints", "HTTPS / JSON")
footer Proposed product design — C# / ASP.NET Core / EF Core / MySQL; implementation is not claimed
@enduml
