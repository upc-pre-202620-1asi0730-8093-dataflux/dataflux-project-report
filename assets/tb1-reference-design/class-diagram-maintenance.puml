@startuml
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam dpi 130
package "Interfaces Layer" {
  class MaintenanceController <<Controller>> {
    - maintenanceService: MaintenanceApplicationService
    + reportIncident(command: ReportIncidentCommand): IncidentResponse
    + scheduleMaintenance(command: ScheduleMaintenanceCommand): MaintenanceRecordResponse
    + completeMaintenance(recordId: MaintenanceRecordId): void
  }
}

package "Application Layer" {
  class MaintenanceApplicationService <<Application Service>> {
    - incidentRepository: IncidentRepository
    - maintenanceRepository: MaintenanceRecordRepository
    - equipmentStatusPort: EquipmentStatusPort
    + reportIncident(equipmentId: EquipmentId, description: IncidentDescription, severity: SeverityLevel): IncidentId
    + scheduleMaintenance(equipmentId: EquipmentId, scheduledDate: DateOnly): MaintenanceRecordId
    + completeMaintenance(recordId: MaintenanceRecordId): void
  }

  interface EquipmentStatusPort <<Port>> {
    + markUnderMaintenance(equipmentId: EquipmentId): void
    + markAvailable(equipmentId: EquipmentId): void
  }
}

package "Infrastructure Layer" {
  class IncidentRepositoryImpl <<Repository Implementation>>
  class MaintenanceRecordRepositoryImpl <<Repository Implementation>>
  class InventoryEquipmentStatusAdapter <<Context Adapter>>
}

package "Domain Layer" {
  class Incident <<Aggregate Root>> {
    - id: IncidentId
    - equipmentId: EquipmentId
    - contractId: RentalContractId
    - reportedAt: DateTimeOffset
    - severity: SeverityLevel
    - status: IncidentStatus
    - description: IncidentDescription
    + resolve(): void
  }

  class MaintenanceRecord <<Aggregate Root>> {
    - id: MaintenanceRecordId
    - equipmentId: EquipmentId
    - incidentId: IncidentId
    - type: MaintenanceType
    - scheduledDate: DateOnly
    - completedDate: DateOnly
    - cost: Money
    - notes: MaintenanceNotes
    - status: MaintenanceStatus
    + markAsCompleted(): void
  }

  enum SeverityLevel <<Enum>> {
    LOW
    MEDIUM
    HIGH
    CRITICAL
  }

  enum IncidentStatus <<Enum>> {
    OPEN
    IN_PROGRESS
    RESOLVED
    CLOSED
  }

  enum MaintenanceType <<Enum>> {
    PREVENTIVE
    CORRECTIVE
  }

  enum MaintenanceStatus <<Enum>> {
    SCHEDULED
    IN_PROGRESS
    COMPLETED
    CANCELLED
  }

  class IncidentDescription <<Value Object>> {
    - value: string
  }
  class MaintenanceNotes <<Value Object>> {
    - value: string
  }

  interface IncidentRepository <<Repository>>
  interface MaintenanceRecordRepository <<Repository>>
}

MaintenanceController --> MaintenanceApplicationService
MaintenanceApplicationService --> IncidentRepository
MaintenanceApplicationService --> MaintenanceRecordRepository
MaintenanceApplicationService --> EquipmentStatusPort

IncidentRepositoryImpl ..|> IncidentRepository
MaintenanceRecordRepositoryImpl ..|> MaintenanceRecordRepository
InventoryEquipmentStatusAdapter ..|> EquipmentStatusPort

Incident "1" --> "1" SeverityLevel
Incident "1" --> "1" IncidentStatus
Incident "1" *-- "1" IncidentDescription
MaintenanceRecord "1" --> "1" MaintenanceType
MaintenanceRecord "1" --> "1" MaintenanceStatus
MaintenanceRecord "1" *-- "0..1" MaintenanceNotes
MaintenanceRecord "0..1" --> "0..1" Incident : originates from
footer Proposed product design — C# / ASP.NET Core / EF Core / MySQL; implementation is not claimed
@enduml
