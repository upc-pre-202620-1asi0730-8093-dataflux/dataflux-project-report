@startuml
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam dpi 130
!include <C4/C4_Component>

LAYOUT_WITH_LEGEND()

title RentBuild - Subscriptions Frontend Components Diagram

Container_Boundary(subscriptions_frontend, "Subscriptions Frontend Bounded Context\n[Vue Bounded Context Module]\n[container]") {
    Component(presentation_layer, "Presentation Layer", "Pages / Components / Routes", "Renders subscription plans, current subscription, plan comparison, and plan management views.")
    Component(application_layer, "Application Layer", "Facades / Services", "Coordinates subscription workflows, plan selection, subscription state, and frontend use cases.")
    Component(infrastructure_layer, "Infrastructure Layer", "API Clients / Mappers", "Consumes Subscriptions backend endpoints and maps subscription resources into frontend models.")
    Component(domain_layer, "Domain Layer", "Models / Rules", "Defines subscription plan, subscription status, billing-related models, and frontend subscription rules.")
}

Component_Ext(iam, "IAM", "Frontend Context", "Provides authenticated account and session context.")
Component_Ext(profiles, "Profiles", "Frontend Context", "Provides company and account profile information associated with the subscription.")
Component_Ext(shared_frontend, "Shared Frontend", "Shared UI / Session", "Provides reusable UI primitives, session utilities, guards, and shared frontend services.")

Container_Ext(backend_api, "RentBuild Backend API", "External Container", "REST API consumed by the Subscriptions frontend context.")

' Internal Container Relationships
Rel(presentation_layer, application_layer, "Dispatches UI actions")
Rel(application_layer, infrastructure_layer, "Requests subscription data")
Rel(application_layer, domain_layer, "Applies subscription and plan rules")

' External Component Relationships
Rel(presentation_layer, shared_frontend, "Uses layout / UI primitives")
Rel(application_layer, iam, "Uses authenticated account context")
Rel(application_layer, profiles, "Uses company profile information")
Rel(application_layer, shared_frontend, "Uses session services")

' External Container Relationships
Rel(infrastructure_layer, backend_api, "Consumes Subscriptions REST endpoints", "JSON / HTTPS")
footer Proposed product design — C# / ASP.NET Core / EF Core / MySQL; implementation is not claimed
@enduml
