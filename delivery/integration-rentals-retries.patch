+    await loadRentals(store);
+    failNext(faultOn('POST', resource), 'after');
+    failNext(faultOn('GET', resource, () => db[resource].length === 1));
+    const confirm = () => returning ? store.registerReturn(1, date(), '', true) : store.registerDelivery(1, date(), '');
